# Copy this file to server/.env and fill in the values.

OPENAI_API_KEY=
# Optional: override the model used for every request.
# OPENAI_MODEL=gpt-5.5

# Same project as the frontend. Used to verify that requests come from logged-in users.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of frontend URLs allowed to call this server.
CLIENT_URL=http://localhost:5173

# AI requests each user can make per hour.
AI_REQUESTS_PER_HOUR=60

PORT=5000

# Payments are off for the free launch. Set to true only after the webhook saves plans.
ENABLE_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
